# -----------------------------------------------------------------------------
# Pin-Spire Environment Configuration Template
# Copy this file to .env.local and fill in the values
# -----------------------------------------------------------------------------

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://postgres:password@localhost:5432/pin_spire?schema=public"

# Custom Cookie Session Secret
SESSION_SECRET="pin-spire-super-secret-key-sketchbook-32-chars-min"

# AWS S3 Storage (Phase 1 - Step 3)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME="pin-spire-uploads"
# Optional CloudFront or Custom CDN URL
# NEXT_PUBLIC_IMAGE_CDN_URL="https://cdn.pinspire.com"
